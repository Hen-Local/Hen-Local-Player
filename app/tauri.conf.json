{
  "productName": "Hen Local Player",
  "version": "0.1.0",
  "identifier": "com.henlocal.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hen Local Player",
        "center": true,
        "width": 720,
        "height": 430,
        "minWidth": 450,
        "minHeight": 300,
        "theme": "Dark",
        "backgroundColor": "#191b20",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "mov",
          "m4v",
          "webm",
          "avi",
          "ts",
          "m2ts",
          "mts",
          "mpg",
          "mpeg",
          "vob",
          "flv",
          "wmv",
          "asf",
          "ogv",
          "3gp",
          "3g2",
          "mxf",
          "rm",
          "rmvb",
          "mp3",
          "m4a",
          "aac",
          "wav",
          "flac",
          "ogg",
          "opus",
          "aiff",
          "aif",
          "ac3",
          "mka",
          "wma",
          "alac"
        ],
        "name": "Media file",
        "role": "Viewer"
      }
    ]
  }
}
